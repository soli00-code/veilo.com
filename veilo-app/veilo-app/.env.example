# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string. Get this from MongoDB Atlas (see HOSTING.md).
MONGO_URI=

# Long, random, secret string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=jhbvtf68f^%Rg765rG75Vu6r8Tug*^*Igv6u8*tgvi87gv&*F68&T&&GUYC86

# Port the server listens on. Most hosts set this for you automatically in production.
PORT=3000

# development | production — set to "production" when deployed, so cookies are sent
# only over HTTPS and error messages don't leak stack traces.
NODE_ENV=development

# The public URL people will use to reach your app once it's hosted, no trailing slash.
# This is used to build shareable profile links and QR codes.
# Locally: http://localhost:3000
# In production: https://your-app-name.onrender.com (or your real domain)
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API with credentials.
# Only needed if you ever split the frontend onto a different domain than the API.
# Leave as-is for the default setup (frontend + API served from the same app).
ALLOWED_ORIGIN=http://localhost:3000
